#cloud-config

# Layer: lfcs. Applied on top of a finished base image (fresh instance-id,
# so cloud-init re-runs even though the disk was already sysprepped).

output:
  all: '| tee -a /var/log/cloud-init-output.log /dev/tty1'

# Base image already created the primary user; re-declaring ssh_authorized_keys
# re-injects a fresh key since sysprep wiped the old one.
users:
  - name: ubuntu
    ssh_authorized_keys:
      - ${SSH_KEY}

package_update: true

packages:
  # Essential Commands & Diagnostics
  - git
  - tree
  - htop
  - tmux
  - screen
  - sysstat
  - vim
  - nano
  - bash-completion
  - python3
  - ca-certificates
  - kmod

  # Remote Access
  - openssh-server
  - openssh-client

  # Storage & Filesystem Management (Domain 3)
  - lvm2
  - mdadm
  - xfsprogs
  - dosfstools
  - nfs-common
  - nfs-kernel-server
  - autofs
  - sshfs
  - quota

  # Networking, Time Sync & Firewalls (Domain 2)
  - network-manager
  - netplan.io
  - firewalld
  - nftables
  - chrony
  - bind9
  - bind9utils
  - bind9-dnsutils
  - iputils-ping
  - traceroute
  - ethtool
  - ifenslave

  # Containers & Virtualization (Domain 1)
  - podman
  - docker.io
  - qemu-system-arm
  - qemu-system-x86
  - libvirt-daemon-system
  - libvirt-clients
  - bridge-utils
  - virtinst

  # Security, Users & Groups (Domain 5)
  - acl
  - apparmor
  - apparmor-utils
  - ldap-utils
  - sshpass

  # Build & package management tooling (used across ATS002 labs/playgrounds)
  - build-essential
  - cron
  - gnupg
  - reprepro
  - dpkg-dev
  - ftp
  - cowsay
  - python3-pip
  - python3-venv
  - python3-dev
  - python3-setuptools
  - python3-wheel

  # Traffic generation & packet inspection (used across ATS003 labs/playgrounds)
  - ncat
  - socat
  - tcpdump
  - nginx

  # I/O & process diagnostics (used across ATS004 labs/playgrounds)
  - iotop
  - lsof
  - fio

runcmd:
  # nftables package auto-enables nftables.service on install, which loads
  # /etc/nftables.conf's stock ruleset (policy drop on input, no ssh accept).
  # That blocks new SSH connections on boot. Disable the service so the
  # package/binary are available for LFCS practice but nothing auto-applies
  # a blocking ruleset; students enable it themselves when practicing.
  - systemctl disable --now nftables

  # Enable and start Docker
  - systemctl enable docker
  - systemctl start docker
  - usermod -aG docker ubuntu

  # Enable and start NetworkManager for nmcli practice
  - systemctl enable NetworkManager
  - systemctl start NetworkManager

  # Enable chrony
  - systemctl enable chrony
  - systemctl start chrony

  # Enable autofs for automounting practice
  - systemctl enable autofs
  - systemctl start autofs

  # Prepare MOTD for practice environment
  - |
    cat << 'EOF' > /etc/update-motd.d/99-lfcs-practice
    #!/bin/sh
    echo "======================================================================"
    echo "  WELCOME TO THE LFCS EXAM PREPARATION ENVIRONMENT"
    echo "======================================================================"
    echo " This image is customized with utilities matching the Linux Foundation"
    echo " Certified System Administrator (LFCS) domains."
    echo ""
    echo " Installed domains & tools:"
    echo "  - Storage:       lvm2, mdadm, xfsprogs, autofs, nfs-common,"
    echo "                   nfs-kernel-server, sshfs, quota"
    echo "  - Network:       network-manager (nmcli), netplan.io, firewalld, nftables,"
    echo "                   chrony, bind9 (+ bind9utils, bind9-dnsutils), ethtool,"
    echo "                   ifenslave, nginx"
    echo "  - Containers:    podman, docker.io"
    echo "  - Virtualization: qemu-system, libvirt-daemon, virtinst"
    echo "  - Commands:      git, htop, tree, sysstat (sar, iostat), acl (setfacl)"
    echo "  - Diagnostics:   ncat, socat, tcpdump, sshpass, iotop, lsof, fio"
    echo ""
    echo " Remember: LFCS is 100% hands-on. PERSISTENCE is key!"
    echo " Ensure all firewalls, mounts (/etc/fstab), and services survive a reboot."
    echo "======================================================================"
    EOF
    chmod +x /etc/update-motd.d/99-lfcs-practice

# No power_state reboot here on purpose -- see distros/ubuntu/user-data.template
# for why: it would race astroimg pipeline's automated post-cloud-init sysprep.
