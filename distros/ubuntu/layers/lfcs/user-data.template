#cloud-config

# Layer: lfcs. Applied on top of a finished base image (fresh instance-id,
# so cloud-init re-runs even though the disk was already sysprepped).

output:
  all: '| tee -a /var/log/cloud-init-output.log /dev/tty1'

# Base image already created the primary user; re-declaring ssh_authorized_keys
# re-injects a fresh key since sysprep wiped the old one.
users:
  - name: ubuntu
    ssh_authorized_keys:
      - ${SSH_KEY}

package_update: true

packages:
  # Essential Commands & Diagnostics
  - git
  - tree
  - htop
  - tmux
  - screen
  - sysstat
  - vim
  - nano
  - bash-completion
  - python3
  - ca-certificates
  - kmod

  # Remote Access
  - openssh-server
  - openssh-client

  # Storage & Filesystem Management (Domain 3)
  - lvm2
  - mdadm
  - xfsprogs
  - dosfstools
  - nfs-common
  - nfs-kernel-server
  - autofs
  - sshfs
  - quota

  # Networking, Time Sync & Firewalls (Domain 2)
  - network-manager
  - netplan.io
  - firewalld
  - nftables
  - chrony
  - bind9
  - bind9utils
  - bind9-dnsutils
  - iputils-ping
  - traceroute
  - ethtool
  - ifenslave

  # Containers & Virtualization (Domain 1)
  - podman
  - docker.io
  - qemu-system-arm
  - qemu-system-x86
  - libvirt-daemon-system
  - libvirt-clients
  - bridge-utils
  - virtinst

  # Security, Users & Groups (Domain 5)
  - acl
  - apparmor
  - apparmor-utils
  - ldap-utils
  - sshpass

  # Build & package management tooling (used across ATS002 labs/playgrounds)
  - build-essential
  - cron
  - gnupg
  - reprepro
  - dpkg-dev
  - ftp
  - cowsay
  - python3-pip
  - python3-venv
  - python3-dev
  - python3-setuptools
  - python3-wheel

  # Traffic generation & packet inspection (used across ATS003 labs/playgrounds)
  - ncat
  - socat
  - tcpdump
  - nginx

  # I/O & process diagnostics (used across ATS004 labs/playgrounds)
  - iotop
  - lsof
  - fio

runcmd:
  # --- Services OFF by default ----------------------------------------------
  # Every daemon below ships installed (so the package and its tooling are
  # there for practice) but is disabled + stopped, so a fresh VM boots fast
  # and clean: nothing races sshd during boot, and no firewall auto-applies a
  # blocking ruleset (nftables' stock /etc/nftables.conf is policy-drop on
  # input with no ssh accept; firewalld/ufw default-deny inbound too).
  # Any lab or playground that needs one of these turns it on itself with
  #   sudo systemctl enable --now <svc>
  # and adds only the rules that task requires.
  - systemctl disable --now nftables 2>/dev/null || true
  - systemctl disable --now firewalld 2>/dev/null || true
  - systemctl disable --now ufw 2>/dev/null || true
  - systemctl disable --now nginx 2>/dev/null || true
  - systemctl disable --now named bind9 2>/dev/null || true
  - systemctl disable --now docker docker.socket containerd 2>/dev/null || true
  - systemctl disable --now libvirtd libvirt-guests 2>/dev/null || true
  - systemctl disable --now virtlogd.socket virtlockd.socket 2>/dev/null || true
  - systemctl disable --now podman-auto-update.timer podman-restart.service 2>/dev/null || true

  # docker group exists from the docker.io package; add the user now so a
  # later `systemctl enable --now docker` needs no re-login.
  - usermod -aG docker ubuntu

  # --- Services ON: part of the base environment itself --------------------
  # NetworkManager: nmcli practice, and it manages the mgmt link on some
  # configs. chrony: correct time everywhere (NTP labs reconfigure it
  # themselves). autofs: automount practice.
  - systemctl enable --now NetworkManager
  - systemctl enable --now chrony
  - systemctl enable --now autofs

  # Prepare MOTD for practice environment
  - |
    cat << 'EOF' > /etc/update-motd.d/99-lfcs-practice
    #!/bin/sh
    echo "======================================================================"
    echo "  WELCOME TO THE LFCS EXAM PREPARATION ENVIRONMENT"
    echo "======================================================================"
    echo " This image is customized with utilities matching the Linux Foundation"
    echo " Certified System Administrator (LFCS) domains."
    echo ""
    echo " Installed domains & tools:"
    echo "  - Storage:       lvm2, mdadm, xfsprogs, autofs, nfs-common,"
    echo "                   nfs-kernel-server, sshfs, quota"
    echo "  - Network:       network-manager (nmcli), netplan.io, firewalld, nftables,"
    echo "                   chrony, bind9 (+ bind9utils, bind9-dnsutils), ethtool,"
    echo "                   ifenslave, nginx"
    echo "  - Containers:    podman, docker.io"
    echo "  - Virtualization: qemu-system, libvirt-daemon, virtinst"
    echo "  - Commands:      git, htop, tree, sysstat (sar, iostat), acl (setfacl)"
    echo "  - Diagnostics:   ncat, socat, tcpdump, sshpass, iotop, lsof, fio"
    echo ""
    echo " Firewall (nftables, firewalld, ufw), web (nginx), DNS (bind9), and"
    echo " container (docker, podman, libvirt) services are INSTALLED but OFF by"
    echo " default. Enable what a task needs:  sudo systemctl enable --now <svc>"
    echo ""
    echo " Remember: LFCS is 100% hands-on. PERSISTENCE is key!"
    echo " Ensure all firewalls, mounts (/etc/fstab), and services survive a reboot."
    echo "======================================================================"
    EOF
    chmod +x /etc/update-motd.d/99-lfcs-practice

# No power_state reboot here on purpose -- see distros/ubuntu/user-data.template
# for why: it would race astroimg pipeline's automated post-cloud-init sysprep.
